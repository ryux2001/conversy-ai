NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Whisper runs in the browser via WebGPU. The default downloads/caches model weights in this browser.
NEXT_PUBLIC_WHISPER_MODEL_SOURCE=hub
NEXT_PUBLIC_WHISPER_MODEL_ID=onnx-community/whisper-base.en

# Development only: set source=local and point to a folder containing the model repo files.
# This folder must include config/tokenizer files and onnx/encoder_model.onnx +
# onnx/decoder_model_merged_q4.onnx. The folder itself is never exposed wholesale.
# NEXT_PUBLIC_WHISPER_MODEL_SOURCE=local
# WHISPER_MODEL_DIR=C:/models/whisper-base.en
