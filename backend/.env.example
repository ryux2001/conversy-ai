PORT=3001
WEB_ORIGIN=http://localhost:3000

# true = only use the local llama.cpp server; false = use OpenRouter.
AI_LOCAL_ONLY=true

# llama.cpp API URL and model alias accepted by the running server.
LOCAL_AI_URL=http://127.0.0.1:8080/v1
LOCAL_AI_MODEL=LFM2.5
LLM_TIMEOUT_MS=90000

# Only required when AI_LOCAL_ONLY=false. Keep this key in the backend, never in Web.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Speech-to-text: local OpenAI-compatible endpoint (for example, llama.cpp with an ASR model).
SPEECH_STT_PROVIDER=local
SPEECH_STT_URL=http://127.0.0.1:8081/v1/audio/transcriptions
SPEECH_STT_MODEL=
SPEECH_STT_TIMEOUT_MS=60000
SPEECH_STT_API_KEY=

# TTS defaults to browser voices so no audio is sent to a speech provider.
SPEECH_TTS_PROVIDER=browser
SPEECH_TTS_URL=http://127.0.0.1:8082/v1/audio/speech
SPEECH_TTS_MODEL=
SPEECH_TTS_VOICE=alloy
SPEECH_TTS_API_KEY=
SPEECH_TTS_TIMEOUT_MS=60000

# Pronunciation assessment is disabled until a provider is deliberately configured.
# Azure Speech sends the learner's voice to the configured Azure resource.
SPEECH_PRONUNCIATION_PROVIDER=disabled
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=
AZURE_SPEECH_LOCALE=en-US
AZURE_SPEECH_TTS_URL=
AZURE_SPEECH_TTS_VOICE=en-US-JennyNeural
